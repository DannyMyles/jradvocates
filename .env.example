# Public URL of the site (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.jradvocates.com

# Contact form (SMTP). Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries are delivered (defaults to enquiries@jradvocates.com) and the From header.
CONTACT_TO=enquiries@jradvocates.com
CONTACT_FROM=

# Newsletter (the current WordPress site uses Mailchimp for WP)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
